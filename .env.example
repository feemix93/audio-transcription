NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgres://transcriber:transcriber_password@localhost:5432/transcriptions

# Redis / BullMQ
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# OpenAI
OPENAI_API_KEY=replace_me
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Set a strong value to protect the API. In development, blank means no auth.
API_KEY=

# Local storage is for local development or a single server with a persistent disk.
DATA_DIR=./data
UPLOAD_MAX_MB=100
CHUNK_SECONDS=300
WORKER_CONCURRENCY=2
TRANSCRIPTION_MAX_ATTEMPTS=3
QUEUE_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=1000
